PORT=5000
MONGO_URI=mongodb://mongo:27017/agrinex
REDIS_URL=redis://redis:6379

# Government of India Mandi API (data.gov.in / DMI)
# Register at https://data.gov.in to obtain an API key for live daily Mandi sync
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
MARKET_PRICE_CACHE_TTL=3600
MARKET_API_TIMEOUT=10000
MARKET_API_MAX_RETRIES=3

JWT_SECRET=agrinex_jwt_secret_token_change_me_in_prod
JWT_REFRESH_SECRET=agrinex_refresh_secret_key_change_me
VERIFICATION_MODE=mock
PAYMENT_MODE=mock
PAYMENT_PROVIDER=mock
DEMO_TRACKING_MODE=true
AI_PROVIDER=rules
MAP_PROVIDER=osm
CAMERA_FEATURE=true
CROP_IMAGE_MAX_SIZE_MB=10
CROP_SCAN_MODE=demo
AI_CROP_SCAN_MODE=demo
IMAGE_STORAGE_MODE=local
IMAGE_COMPRESSION=true
THREE_D_ENABLED=true
THREE_D_MOBILE_ENABLED=false
REDUCED_MOTION_SUPPORT=true
WEBGL_FALLBACK=true
